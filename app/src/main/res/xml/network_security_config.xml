<network-security-config>
    <!-- All traffic must use TLS; servers are only reachable over https:// and wss://. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <!-- Applies only to debuggable builds, so a debugging proxy with a user-installed CA can be used. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
